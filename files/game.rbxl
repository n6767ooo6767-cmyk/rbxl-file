<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <External>null</External>
  <External>nil</External>
  <Item class="Workspace" referent="RBXWORKSPACE">
    <Properties>
      <string name="Name">Workspace</string>
    </Properties>
  </Item>
  <Item class="ServerScriptService" referent="RBXSERVER">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBXMAIN">
      <Properties>
        <string name="Name">MainGame</string>
        <ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local DataStoreService=game:GetService("DataStoreService")
local Lighting=game:GetService("Lighting")

local store=DataStoreService:GetDataStore("MyHouseNotMine_v1")
local events=ReplicatedStorage:FindFirstChild("HouseEvents") or Instance.new("Folder",ReplicatedStorage)
events.Name="HouseEvents"
local message=events:FindFirstChild("Message") or Instance.new("RemoteEvent",events)
message.Name="Message"

local old=workspace:FindFirstChild("MY_HOUSE_GAME")
if old then old:Destroy() end
local world=Instance.new("Folder",workspace)
world.Name="MY_HOUSE_GAME"

local function part(name,size,pos,material)
    local p=Instance.new("Part",world)
    p.Name=name
    p.Size=size
    p.Position=pos
    p.Anchored=true
    p.Material=material or Enum.Material.SmoothPlastic
    return p
end

part("Floor",Vector3.new(80,1,50),Vector3.new(0,0,0),Enum.Material.Wood)
part("BackWall",Vector3.new(80,16,1),Vector3.new(0,8,-25))
part("LeftWall",Vector3.new(1,16,50),Vector3.new(-40,8,0))
part("RightWall",Vector3.new(1,16,50),Vector3.new(40,8,0))
part("FrontWall",Vector3.new(80,16,1),Vector3.new(0,8,25))
part("Table",Vector3.new(10,1,5),Vector3.new(-12,4,0),Enum.Material.Wood)
part("Bed",Vector3.new(10,2,6),Vector3.new(15,2,-14),Enum.Material.Fabric)
part("Sofa",Vector3.new(10,3,4),Vector3.new(12,2,8),Enum.Material.Fabric)

local spawn=Instance.new("SpawnLocation",world)
spawn.Size=Vector3.new(5,1,5)
spawn.Position=Vector3.new(0,2,15)
spawn.Anchored=true
spawn.Neutral=true

local day=1
local money=100
local phase="home"
local groceries=0

local function say(player,text)
    if player and player.Parent then message:FireClient(player,text) end
end

local function save(player)
    pcall(function()
        store:SetAsync("u_"..player.UserId,{day=day,money=money,phase=phase,groceries=groceries})
    end)
end

local function load(player)
    local ok,data=pcall(function()
        return store:GetAsync("u_"..player.UserId)
    end)
    if ok and data then
        day=data.day or day
        money=data.money or money
        phase=data.phase or phase
        groceries=data.groceries or groceries
    end
end

Players.PlayerAdded:Connect(function(player)
    load(player)
    task.wait(1)
    say(player,"День "..day.." • "..phase.." • $"..money)
    player.CharacterAdded:Connect(function(character)
        task.wait(.2)
        character:PivotTo(CFrame.new(0,3,14))
    end)
end)

Players.PlayerRemoving:Connect(save)

while true do
    task.wait(12)
    for _,player in Players:GetPlayers() do
        if phase=="home" then
            say(player,"🌅 Утро. Пора собираться на работу.")
            phase="work"
        elseif phase=="work" then
            money+=80
            say(player,"💼 Работа закончена. Зарплата +$80. Загляни в магазин.")
            phase="shop"
        elseif phase=="shop" then
            if money>=25 then
                money-=25
                groceries+=1
                say(player,"🛒 Ты купил продукты за $25.")
            else
                say(player,"🛒 Денег мало. Придётся идти домой.")
            end
            phase="home"
        else
            day+=1
            say(player,"🌙 Ты лёг спать. День "..day.." начинается завтра.")
        end
        save(player)
    end
    Lighting.ClockTime=(day%2==0) and 8 or 20
end]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBXSTARTER">
    <Properties><string name="Name">StarterPlayer</string></Properties>
    <Item class="StarterPlayerScripts" referent="RBXSCRIPTS">
      <Properties><string name="Name">StarterPlayerScripts</string></Properties>
      <Item class="LocalScript" referent="RBXCLIENT">
        <Properties>
          <string name="Name">MainUI</string>
          <ProtectedString name="Source"><![CDATA[local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local player=Players.LocalPlayer
local message=ReplicatedStorage:WaitForChild("HouseEvents"):WaitForChild("Message")
local gui=Instance.new("ScreenGui",player:WaitForChild("PlayerGui"))
gui.Name="MyHouseUI"
gui.ResetOnSpawn=false
local frame=Instance.new("Frame",gui)
frame.AnchorPoint=Vector2.new(.5,.5)
frame.Position=UDim2.fromScale(.5,.88)
frame.Size=UDim2.fromScale(.75,.11)
frame.BackgroundColor3=Color3.fromRGB(10,10,15)
frame.BackgroundTransparency=1
local label=Instance.new("TextLabel",frame)
label.Size=UDim2.fromScale(1,1)
label.BackgroundTransparency=1
label.TextColor3=Color3.new(1,1,1)
label.TextScaled=true
label.Font=Enum.Font.GothamMedium
message.OnClientEvent:Connect(function(text)
    label.Text=text
    frame.BackgroundTransparency=1
    frame.Visible=true
    TweenService:Create(frame,TweenInfo.new(.35),{BackgroundTransparency=.15}):Play()
    task.wait(4)
    TweenService:Create(frame,TweenInfo.new(.5),{BackgroundTransparency=1}):Play()
    task.wait(.55)
    frame.Visible=false
end)]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>
