<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <External>null</External>
  <External>nil</External>
  <Item class="Workspace" referent="RBXWORKSPACE">
    <Properties><string name="Name">Workspace</string></Properties>
    <Item class="Part" referent="RBXGROUND">
      <Properties>
        <string name="Name">Ground</string>
        <Vector3 name="size"><X>200</X><Y>1</Y><Z>160</Z></Vector3>
        <CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
        <bool name="Anchored">true</bool>
        <token name="Material">512</token>
      </Properties>
    </Item>
    <Item class="SpawnLocation" referent="RBXSPAWN">
      <Properties>
        <string name="Name">SafeSpawn</string>
        <Vector3 name="size"><X>8</X><Y>1</Y><Z>8</Z></Vector3>
        <CoordinateFrame name="CFrame"><X>0</X><Y>3</Y><Z>55</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame>
        <bool name="Anchored">true</bool>
        <bool name="Neutral">true</bool>
        <bool name="AllowTeamChangeOnTouch">false</bool>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBXSERVER">
    <Properties><string name="Name">ServerScriptService</string></Properties>
    <Item class="Script" referent="RBXMAIN">
      <Properties>
        <string name="Name">MyHouseNotMine</string>
        <ProtectedString name="Source"><![CDATA[
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local Lighting = game:GetService("Lighting")

local STORE = DataStoreService:GetDataStore("MyHouseNotMine_v4")
local world = Instance.new("Folder")
world.Name = "MY_HOUSE_GAME"
world.Parent = workspace

local states = {}
local DAY_LENGTH = 600
local MAX_DAY = 12

local function makePart(parent, name, size, pos, material, color)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Position = name, size, pos
	p.Anchored = true
	p.Material = material or Enum.Material.SmoothPlastic
	if color then p.Color = color end
	p.Parent = parent
	return p
end

local function say(player, text)
	local pg = player:FindFirstChildOfClass("PlayerGui")
	if not pg then return end
	local gui = pg:FindFirstChild("MyHouseUI")
	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = "MyHouseUI"
		gui.ResetOnSpawn = false
		gui.Parent = pg
		local box = Instance.new("TextLabel")
		box.Name = "Info"
		box.Position = UDim2.fromScale(.15,.04)
		box.Size = UDim2.fromScale(.7,.08)
		box.BackgroundColor3 = Color3.fromRGB(12,12,18)
		box.BackgroundTransparency = .15
		box.TextColor3 = Color3.new(1,1,1)
		box.TextScaled = true
		box.Font = Enum.Font.GothamBold
		box.Parent = gui
	end
	gui.Info.Text = text
end

local function teleport(player, pos)
	if player.Character then player.Character:PivotTo(CFrame.new(pos)) end
end

local function prompt(parent, action, object, callback)
	local p = Instance.new("ProximityPrompt")
	p.ActionText, p.ObjectText = action, object
	p.HoldDuration = .4
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p.Parent = parent
	p.Triggered:Connect(callback)
end

local ground = workspace:FindFirstChild("Ground")
if ground then ground.Color = Color3.fromRGB(70,105,70) end

-- ДОМ
local home = Instance.new("Folder", world)
home.Name = "HOME"
makePart(home,"Floor",Vector3.new(48,1,34),Vector3.new(-55,2,25),Enum.Material.Wood,Color3.fromRGB(120,82,55))
makePart(home,"BackWall",Vector3.new(48,14,1),Vector3.new(-55,9,42),Enum.Material.Wood,Color3.fromRGB(90,65,50))
makePart(home,"LeftWall",Vector3.new(1,14,34),Vector3.new(-79,9,25),Enum.Material.Wood,Color3.fromRGB(90,65,50))
makePart(home,"RightWall",Vector3.new(1,14,34),Vector3.new(-31,9,25),Enum.Material.Wood,Color3.fromRGB(90,65,50))
makePart(home,"FrontLeft",Vector3.new(18,14,1),Vector3.new(-70,9,8),Enum.Material.Wood,Color3.fromRGB(90,65,50))
makePart(home,"FrontRight",Vector3.new(18,14,1),Vector3.new(-40,9,8),Enum.Material.Wood,Color3.fromRGB(90,65,50))
makePart(home,"Bed",Vector3.new(10,2,7),Vector3.new(-42,3,34),Enum.Material.Fabric,Color3.fromRGB(75,85,115))
makePart(home,"Table",Vector3.new(9,2,5),Vector3.new(-68,3,24),Enum.Material.Wood,Color3.fromRGB(100,65,40))
makePart(home,"Sofa",Vector3.new(11,3,4),Vector3.new(-64,3,35),Enum.Material.Fabric,Color3.fromRGB(65,65,70))
local door = makePart(home,"Door",Vector3.new(6,7,1),Vector3.new(-55,5,8),Enum.Material.Glass,Color3.fromRGB(90,145,190))
local sleep = makePart(home,"SleepSpot",Vector3.new(5,1,3),Vector3.new(-42,4,27),Enum.Material.SmoothPlastic)

-- РАБОТА
local work = Instance.new("Folder", world)
work.Name = "WORK"
makePart(work,"Building",Vector3.new(36,12,28),Vector3.new(45,6,25),Enum.Material.Concrete,Color3.fromRGB(90,90,95))
local desk = makePart(work,"Desk",Vector3.new(10,2,5),Vector3.new(45,3,25),Enum.Material.Metal,Color3.fromRGB(55,55,60))

-- МАГАЗИН
local shop = Instance.new("Folder", world)
shop.Name = "SHOP"
makePart(shop,"Building",Vector3.new(30,11,24),Vector3.new(0,5.5,45),Enum.Material.Brick,Color3.fromRGB(120,75,55))
local shelf = makePart(shop,"Shelf",Vector3.new(10,4,3),Vector3.new(0,3,41),Enum.Material.Wood,Color3.fromRGB(100,65,40))

-- Указатели
local function sign(partObj, text)
	local b = Instance.new("BillboardGui", partObj)
	b.Size = UDim2.fromOffset(260,60)
	b.StudsOffset = Vector3.new(0,8,0)
	b.AlwaysOnTop = true
	local t = Instance.new("TextLabel", b)
	t.Size = UDim2.fromScale(1,1)
	t.BackgroundColor3 = Color3.fromRGB(15,15,20)
	t.BackgroundTransparency = .2
	t.TextColor3 = Color3.new(1,1,1)
	t.TextScaled = true
	t.Font = Enum.Font.GothamBold
	t.Text = text
end
sign(home,"🏠 МОЙ ДОМ")
sign(work,"💼 РАБОТА")
sign(shop,"🛒 МАГАЗИН")

local function save(player)
	local s = states[player]
	if not s then return end
	pcall(function()
		STORE:SetAsync("u_"..player.UserId,{day=s.day,money=s.money,groceries=s.groceries})
	end)
end

local function load(player)
	local s = {day=1,money=100,groceries=0,phase="home",elapsed=0,workDone=false}
	local ok,data = pcall(function() return STORE:GetAsync("u_"..player.UserId) end)
	if ok and type(data)=="table" then
		s.day = math.clamp(tonumber(data.day) or 1,1,MAX_DAY)
		s.money = tonumber(data.money) or 100
		s.groceries = tonumber(data.groceries) or 0
	end
	states[player] = s
	return s
end

prompt(door,"Идти на работу","Дверь",function(player)
	local s=states[player]
	if s and s.phase=="home" then
		s.phase="work"
		teleport(player,Vector3.new(45,4,17))
		say(player,"🚶 Ты пришёл на работу. Подойди к столу.")
	end
end)

prompt(desk,"Работать","Рабочее место",function(player)
	local s=states[player]
	if not s or s.phase~="work" then say(player,"Сейчас не время работать."); return end
	if s.workDone then say(player,"Ты уже закончил смену."); return end
	s.workDone=true
	s.money += 80
	s.phase="shop"
	teleport(player,Vector3.new(45,4,17))
	say(player,"💼 Смена закончена! +$80. Теперь магазин.")
end)

prompt(shelf,"Купить продукты ($25)","Магазин",function(player)
	local s=states[player]
	if not s or s.phase~="shop" then say(player,"Сначала закончи работу."); return end
	if s.money<25 then say(player,"💸 Не хватает денег."); return end
	s.money-=25
	s.groceries+=1
	s.phase="home"
	teleport(player,Vector3.new(-55,4,18))
	say(player,"🛒 Продукты куплены. Пора домой.")
end)

prompt(sleep,"Спать","Кровать",function(player)
	local s=states[player]
	if not s or s.phase~="home" then say(player,"Сейчас нельзя спать."); return end
	s.elapsed=DAY_LENGTH
	say(player,"🌙 Ты лёг спать...")
end)

Players.PlayerAdded:Connect(function(player)
	local s=load(player)
	player.CharacterAdded:Connect(function()
		task.wait(.3)
		teleport(player,Vector3.new(-55,4,18))
		say(player,"🏠 День "..s.day..". Иди к двери и отправляйся на работу.")
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	save(player)
	states[player]=nil
end)

task.spawn(function()
	while true do
		task.wait(1)
		for player,s in pairs(states) do
			if player.Parent then
				s.elapsed += 1
				Lighting.ClockTime = 7 + ((s.elapsed % DAY_LENGTH) / DAY_LENGTH) * 14
				if s.elapsed >= DAY_LENGTH then
					s.day += 1
					s.phase="home"
					s.elapsed=0
					s.workDone=false
					if s.day>MAX_DAY then s.day=MAX_DAY end
					if s.day>=3 and math.random()<.55 then
						local bed=home:FindFirstChild("Bed")
						if bed then bed.Position=Vector3.new(-42,3,math.random(30,36)) end
						say(player,"😶 День "..s.day..". Кажется, кто-то двигал вещи...")
					else
						say(player,"🌅 Начался день "..s.day..".")
					end
					teleport(player,Vector3.new(-55,4,18))
					save(player)
				end
			end
		end
	end
end)

print("[MyHouseNotMine] Loaded successfully")
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>
